{
  "name": "rlchess",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsc && node --import tsx --test test/*.test.ts",
    "restore": "tsx src/worker.ts restore",
    "play": "tsx src/worker.ts play",
    "train": "tsx src/worker.ts train",
    "eval": "tsx src/worker.ts eval",
    "publish": "tsx src/worker.ts publish",
    "run": "npm run restore && npm run play && npm run train && npm run eval && npm run publish"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
